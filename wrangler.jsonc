{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rizki-portfolio-preview",
  "main": "src/server.ts",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "observability": { "enabled": true },
  "vars": {
    "PUBLIC_HOST": "txtfromrizkirmdhn.my.id",
    "ADMIN_HOST": "admin.txtfromrizkirmdhn.my.id",
    "OWNER_EMAIL": "achmadrizkiramadhan0101@gmail.com",
    "ACCESS_TEAM_DOMAIN": "rizkirmdhn.cloudflareaccess.com",
    "ACCESS_AUD": "09d658c56c9a0a3b335624bb5eaf2be296a89c655c80ca5c129b0cb54673d0c0",
    "CF_ACCOUNT_ID": "4a273df5ad27c77f3a28a6d0bbcf770f",
    "ANALYTICS_SITE_TAG": "",
    "ANALYTICS_BEACON_TOKEN": "",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rizki-portfolio-preview",
      "database_id": "cc415328-cdcc-4cf4-8449-42f401c41ecd",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "rizki-portfolio-preview-media" },
  ],
  "env": {
    "production": {
      "name": "rizki-portfolio",
      "routes": [
        { "pattern": "admin.txtfromrizkirmdhn.my.id", "custom_domain": true },
        {
          "pattern": "txtfromrizkirmdhn.my.id/*",
          "zone_name": "txtfromrizkirmdhn.my.id",
        },
      ],
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "PUBLIC_HOST": "txtfromrizkirmdhn.my.id",
        "ADMIN_HOST": "admin.txtfromrizkirmdhn.my.id",
        "OWNER_EMAIL": "achmadrizkiramadhan0101@gmail.com",
        "ACCESS_TEAM_DOMAIN": "rizkirmdhn.cloudflareaccess.com",
        "ACCESS_AUD": "09d658c56c9a0a3b335624bb5eaf2be296a89c655c80ca5c129b0cb54673d0c0",
        "CF_ACCOUNT_ID": "4a273df5ad27c77f3a28a6d0bbcf770f",
        "ANALYTICS_SITE_TAG": "0540126c3fcd437493b69ef2746c9df8",
        "ANALYTICS_BEACON_TOKEN": "3a30f1f363af4559b7af85eb66f0f9d1",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "rizki-portfolio",
          "database_id": "273db981-25ed-4464-82f3-d646fc3dc4b8",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [
        { "binding": "MEDIA", "bucket_name": "rizki-portfolio-media" },
      ],
    },
  },
}
