---
import Base from "../layouts/Base.astro";
---

<Base title="Not found" description="The page you are looking for does not exist." image="/og.png">
	<main id="main" class="page not-found">
		<p class="detail-meta">404</p>
		<h1>This page is not here.</h1>
		<p class="detail-summary">The address may have changed, or the page was never published.</p>
		<a class="button primary" href="/">Back to the profile</a>
	</main>
</Base>
