---
import { Moon, Sun } from "@lucide/astro";
---

<button
	class="theme-button"
	type="button"
	aria-label="Switch theme"
	title="Switch theme"
	data-theme-toggle
>
	<span class="theme-glyph" aria-hidden="true">
		<Sun class="theme-sun" size={18} />
		<Moon class="theme-moon" size={18} />
	</span>
</button>
