{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "rizki-portfolio-emdash",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-09-05",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"preview_urls": false,
	"observability": { "enabled": true },
	"vars": {
		"EMDASH_SITE_URL": "https://txtfromrizkirmdhn.my.id",
		"ANALYTICS_BEACON_TOKEN": "3a30f1f363af4559b7af85eb66f0f9d1"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "rizki-portfolio-emdash",
			"database_id": "c148c223-054f-4325-8574-4c127174e81f"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "rizki-portfolio-emdash-media"
		}
	],
	"kv_namespaces": [
		{ "binding": "SESSION", "id": "c9135d86cfea4439bb0593637f31c696" }
	],
	"images": { "binding": "IMAGES" },
	"routes": [
		{
			"pattern": "txtfromrizkirmdhn.my.id/*",
			"zone_name": "txtfromrizkirmdhn.my.id"
		}
	],
	"triggers": {
		"crons": ["* * * * *"]
	}
}
