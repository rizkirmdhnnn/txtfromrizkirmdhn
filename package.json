{
  "name": "rizki-portfolio",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "cf:typegen": "wrangler types --strict-vars=false --env-file .dev.vars.example",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "test": "vitest run",
    "preview": "vite preview",
    "deploy:preview": "npm run build && wrangler deploy",
    "deploy:production": "CLOUDFLARE_ENV=production npm run build && wrangler deploy --env production"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-start": "^1.168.49",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/markdown": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "fflate": "^0.8.3",
    "jose": "^6.2.11",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "yaml": "^2.8.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.4",
    "@cloudflare/workers-types": "^5.20260905.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "wrangler": "^4.129.0",
    "miniflare": "5.20260903.0-alpha"
  }
}
